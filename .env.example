# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional e-mail this app sends itself, e.g. new-message notifications)
RESEND_API_KEY=your_resend_api_key

# Cloudflare Turnstile (CAPTCHA on /register — unset locally is fine, the
# widget just doesn't render and signup isn't gated; Supabase Auth's own
# security_captcha_enabled setting is the actual enforcement, separate from
# this key existing client-side)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
